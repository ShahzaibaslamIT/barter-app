# ============================================================================
# barter-app — environment variables (monorepo)
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in real values:  cp .env.example .env
# NEVER commit `.env`. In production each Vercel PROJECT gets only the vars its
# app actually needs (see the per-app split below) — do not put web secrets on
# the admin project or vice-versa.
#
# Two deployable apps share this repo:
#   • apps/web   (marketplace)        → barter-app-gamma.vercel.app
#   • apps/admin (admin panel)        → barter-admin-wine.vercel.app
# Shared packages: @barter/db (Prisma), @barter/ui, @barter/types, @barter/config
# ============================================================================


# ─── SHARED — both apps (consumed via @barter/db) ──────────────────────────
# Neon Postgres pooled connection string. Same database for both apps.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"


# ─── apps/admin ONLY ───────────────────────────────────────────────────────
# Secret used to sign/verify the admin session JWT (`admin_token` cookie).
# Admin-only: the web app no longer issues or verifies admin tokens.
# Use a long random string (e.g. `openssl rand -base64 32`).
JWT_SECRET="change-me-admin-jwt-signing-secret"
#   Also needs: DATABASE_URL (above).


# ─── apps/web ONLY ─────────────────────────────────────────────────────────
# NextAuth (user authentication)
NEXTAUTH_SECRET="change-me-nextauth-secret"
# Production only: the canonical user-app URL (NextAuth callback base).
# Leave unset in local dev (NextAuth infers http://localhost:3000).
# NEXTAUTH_URL="https://www.your-domain.com"

# Google OAuth (the "Continue with Google" flow). Redirect URIs must be
# registered in Google Cloud Console for every origin (localhost + prod).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Custom JWT used by apps/web/lib/auth.ts (email/password user tokens).
# Distinct concern from the admin JWT_SECRET above, but the var name is shared —
# set it on the web project too.
# JWT_SECRET="change-me-web-jwt-signing-secret"

# Cloudinary (listing image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Twilio (phone OTP / verification)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""

# Resend (transactional email)
RESEND_API_KEY=""

# OneSignal (web push notifications)
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""
NEXT_PUBLIC_ONESIGNAL_APP_ID=""


# ─── Admin bootstrap (one-off seed script) ─────────────────────────────────
# Used only by `apps/web/scripts/create-admin.ts` to create the first AdminUser
# row (password is bcrypt-hashed). Needs DATABASE_URL. Unset after seeding.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
